# Copy to .env only if you need to override local defaults.
# Never put real credentials in this tracked example file.
VACANCYX_APP_NAME=VacancyX
VACANCYX_ENVIRONMENT=development
VACANCYX_LOG_LEVEL=INFO
VACANCYX_API_HOST=127.0.0.1
VACANCYX_API_PORT=8000
# Optional override; the default is the local .vacancyx/vacancyx.db file.
# VACANCYX_DATABASE_URL=sqlite:///./.vacancyx/vacancyx.db
# Local resume storage directory and upload limit (bytes).
# VACANCYX_STORAGE_DIR=.vacancyx
# VACANCYX_MAX_RESUME_SIZE_BYTES=10485760
# Resume upload storage is private local state, outside the public web root.
# VACANCYX_STORAGE_DIR=.vacancyx
# VACANCYX_MAX_RESUME_SIZE_BYTES=10485760
